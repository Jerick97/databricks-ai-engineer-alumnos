{
  "type": "object",
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "pair": {
      "type": "object",
      "properties": {
        "pair_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "family": {
          "enum": [
            "cybersecurity",
            "market_conduct"
          ]
        },
        "before": {
          "type": "object",
          "properties": {
            "document_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "version_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "document_id",
            "version_id"
          ],
          "additionalProperties": false
        },
        "after": {
          "type": "object",
          "properties": {
            "document_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "version_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "document_id",
            "version_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "pair_id",
        "family",
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "citation_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "document_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "provision_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_kind": {
            "enum": [
              "normative",
              "fictitious_process"
            ]
          }
        },
        "required": [
          "citation_id",
          "document_id",
          "version_id",
          "provision_id",
          "page",
          "start",
          "end",
          "text",
          "source_kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "coverage": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "evidence_id",
    "evidence_version",
    "pair",
    "citations",
    "coverage",
    "limitations",
    "synthetic"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbs:contracts:EvidencePack:0.1.0",
  "title": "EvidencePack",
  "description": "SK01 v0.1.0. Local structural contract. Does not establish source truth, immutable persistence, citation literalness or authenticated authorization. Unknown fields rejected; ModelBundle parameters alone permits scalar extension keys."
}
