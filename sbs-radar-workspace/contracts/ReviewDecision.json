{
  "type": "object",
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "proposed",
        "reviewed",
        "approved",
        "rejected"
      ]
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "actor_role": {
      "enum": [
        "reader",
        "reviewer",
        "compliance_owner"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "review_id",
    "subject_id",
    "review_status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "required": [
          "actor_id",
          "actor_role",
          "reviewed_at",
          "evidence_id",
          "evidence_version"
        ],
        "properties": {
          "actor_role": {
            "enum": [
              "reviewer",
              "compliance_owner"
            ]
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbs:contracts:ReviewDecision:0.1.0",
  "title": "ReviewDecision",
  "description": "SK01 v0.1.0. Local structural contract. Does not establish source truth, immutable persistence, citation literalness or authenticated authorization. Unknown fields rejected; ModelBundle parameters alone permits scalar extension keys.",
  "dependentRequired": {
    "evidence_id": [
      "evidence_version"
    ],
    "evidence_version": [
      "evidence_id"
    ]
  }
}
