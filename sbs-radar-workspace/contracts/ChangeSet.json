    },
    "review": {
      "type": "object",
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "proposed",
            "reviewed",
            "approved",
            "rejected"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "actor_role": {
          "enum": [
            "reader",
            "reviewer",
            "compliance_owner"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "review_id",
        "subject_id",
        "review_status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "required": [
              "actor_id",
              "actor_role",
              "reviewed_at",
              "evidence_id",
              "evidence_version"
            ],
            "properties": {
              "actor_role": {
                "enum": [
                  "reviewer",
                  "compliance_owner"
                ]
              }
            }
          }
        }
      ],
      "dependentRequired": {
        "evidence_id": [
          "evidence_version"
        ],
        "evidence_version": [
          "evidence_id"
        ]
      }
    }
